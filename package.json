{
  "name": "@rickkwang/noa-claude",
  "version": "1.8.0",
  "type": "module",
  "private": false,
  "description": "Noa Claude - isolated AI coding assistant",
  "homepage": "https://github.com/rickkwang/Noa-Claude",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickkwang/Noa-Claude.git"
  },
  "bugs": {
    "url": "https://github.com/rickkwang/Noa-Claude/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "noa": "./bin/noa.js"
  },
  "scripts": {
    "build": "bun run build.ts",
    "build:dev": "bun run build.ts --dev",
    "build:dev:full": "bun run build.ts --dev --feature-set=dev-full",
    "compile": "bun run build.ts --compile",
    "compile:dev": "bun run build.ts --compile --dev",
    "dev": "bun run build.ts --dev && bun ./dist/main-dev.js",
    "dev:source": "bun ./dev-launcher.js",
    "check:runtime": "bun ./scripts/check-runtime-health.mjs",
    "check:docs": "bun ./scripts/check-doc-consistency.mjs",
    "verify:ports": "bun ./scripts/verify-ported-prompts.ts",
    "smoke:features": "bun ./scripts/smoke-features.mjs",
    "smoke:perf": "bun ./scripts/smoke-perf.mjs",
    "smoke:engine": "bun ./scripts/smoke-engineering.mjs",
    "smoke:engine:live": "bun ./scripts/smoke-engineering-live.mjs",
    "scan:pr-intent": "node ./scripts/pr-intent-scan.mjs --fail-on high",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:quality": "bun run typecheck && bun run check:docs",
    "lint": "echo \"lint alias: running quality checks (typecheck + docs consistency)\" && bun run check:quality"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.27.0",
    "@anthropic-ai/foundry-sdk": "^0.2.3",
    "@anthropic-ai/mcpb": "file:./vendor/anthropic-ai-mcpb",
    "@anthropic-ai/sandbox-runtime": "^0.0.70",
    "@anthropic-ai/sdk": "^0.80.0",
    "@anthropic-ai/vertex-sdk": "^0.16.0",
    "@aws-sdk/client-bedrock": "^3.700.0",
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-sts": "^3.1022.0",
    "@azure/identity": "^4.13.1",
    "@commander-js/extra-typings": "^14.0.0",
    "@growthbook/growthbook": "^1.6.5",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.57.0",
    "@opentelemetry/core": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/instrumentation": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-logs": "^0.57.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "asciichart": "^1.5.25",
    "audio-capture-napi": "^0.0.1",
    "axios": "^1.14.0",
    "bidi-js": "^1.0.3",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "diff": "^8.0.4",
    "env-paths": "^4.0.0",
    "execa": "^9.6.1",
    "fflate": "^0.8.2",
    "figures": "^6.1.0",
    "fuse.js": "^7.1.0",
    "get-east-asian-width": "^1.5.0",
    "google-auth-library": "^9.15.0",
    "highlight.js": "^11.11.1",
    "ignore": "^7.0.5",
    "image-processor-napi": "^0.0.1",
    "ink": "^4.4.1",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.17.21",
    "lru-cache": "^11.2.7",
    "marked": "^17.0.5",
    "modifiers-napi": "^0.0.1",
    "p-map": "^7.0.4",
    "picomatch": "^4.0.4",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-reconciler": "0.33.0",
    "semver": "^7.7.4",
    "sharp": "^0.33.0",
    "shell-quote": "^1.8.3",
    "supports-hyperlinks": "^4.4.0",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.2",
    "url-handler-napi": "^0.0.1",
    "usehooks-ts": "^3.1.1",
    "vscode-jsonrpc": "^8.2.1",
    "xss": "^1.0.15",
    "yaml": "^2.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/lodash-es": "^4.17.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.2"
  },
  "trustedDependencies": [
    "@anthropic-ai/sdk",
    "@modelcontextprotocol/sdk",
    "audio-capture-napi",
    "modifiers-napi"
  ]
}
