{
  "name": "noa-gui",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "NOA_GUI_INSECURE=1 bun run server/main.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "desktop": "NOA_GUI_DEV=1 bun scripts/launch-desktop.mjs",
    "desktop:dist": "bun run build && bun scripts/launch-desktop.mjs",
    "test": "bun test",
    "test:bridge": "bun run tests/bridge.e2e.ts",
    "test:rendering": "bun scripts/e2e-conversation-remaining.ts",
    "test:session-sync": "bun scripts/e2e-session-sync.ts",
    "test:scroll": "bun scripts/e2e-scroll.ts",
    "test:terminal": "bun scripts/e2e-terminal.ts",
    "test:browser": "bun scripts/e2e-browser.ts",
    "test:stats": "bun scripts/e2e-stats.ts",
    "test:files-split": "bun scripts/e2e-files-split.ts",
    "desktop:prepare": "bun scripts/prepare-desktop-runtime.mjs",
    "desktop:pack": "bun run build && bun scripts/prepare-desktop-runtime.mjs && electron-builder --dir --mac --arm64 --publish never",
    "desktop:release": "bun run build && bun scripts/prepare-desktop-runtime.mjs && electron-builder --mac dmg zip --arm64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.2.2",
    "@types/bun": "1.3.9",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.3.4",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "41.10.6",
    "electron-builder": "26.8.2",
    "katex": "0.19.1",
    "mermaid": "12.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.2.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  },
  "main": "electron/main.cjs",
  "version": "1.24.0",
  "build": {
    "appId": "com.noa.agent",
    "productName": "Noa Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release-runtime/bun",
        "to": "bun",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "release-runtime/rg",
        "to": "rg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "sign": "./scripts/sign-mac.cjs"
    },
    "artifactName": "Noa-Agent-${version}-${arch}.${ext}",
    "dmg": {
      "size": "2g"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "rickkwang",
        "repo": "Noa-Claude",
        "releaseType": "release"
      }
    ],
    "afterPack": "./scripts/after-pack.cjs"
  }
}
