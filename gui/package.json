{
  "name": "noa-gui",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "bun run server/main.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "desktop": "NOA_GUI_DEV=1 electron .",
    "desktop:dist": "bun run build && electron .",
